# ============================================================
#  DataMaturity Pro — variables d'environnement
#  Copier en .env et renseigner les valeurs de production.
# ============================================================

# --- Application ---
APP_ENV=production                  # development | production
SECRET_KEY=changez-moi-par-une-chaine-aleatoire-de-64-caracteres
BASE_URL=https://datamaturity.pro
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=XOF                # XOF | EUR | USD

# --- Base de donnees ---
# SQLite (developpement, aucune installation requise)
DATABASE_URL=sqlite:///./data/datamaturity.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/datamaturity

# --- Administration ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe
ADMIN_EMAIL=yvesmouaha@yahoo.fr

# --- Identite commerciale (affichee sur le site et les rapports) ---
BRAND_NAME=DataMaturity Pro
BRAND_OWNER=Yves Mouaha Handy
BRAND_TAGLINE=Diagnostic de maturite data pour les organisations africaines
CONTACT_EMAIL=yvesmouaha@yahoo.fr
CONTACT_PHONE=+225 07 48 78 25 17
CONTACT_WHATSAPP=2250748782517

# --- Taux de change (1 unite de devise = X FCFA) ---
# Modifiables a chaud depuis la vue admin > Tarification.
FX_EUR_TO_XOF=655.957               # parite fixe EUR/XOF
FX_USD_TO_XOF=610.0                 # a actualiser periodiquement

# --- Stripe (carte bancaire, EUR / USD) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# --- CinetPay (Mobile Money Afrique de l'Ouest, XOF) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_MODE=PRODUCTION            # PRODUCTION | TEST

# --- Divers ---
ENABLE_PUBLIC_BENCHMARK=true        # publie le barometre agrege anonymise
MIN_BENCHMARK_SAMPLE=3              # nb mini d'evaluations pour publier un segment
